# Copy this file to .env and fill in the values.
# .env is gitignored — never commit real keys.

# Required: writes the briefing. console.anthropic.com → API Keys
ANTHROPIC_API_KEY=

# Optional locally, required for the daily automation to save results.
# Supabase → project → Settings → API
# Use the SECRET (service_role) key here, not the publishable one.
SUPABASE_URL=
SUPABASE_KEY=

# Required for the email-delivery cron (scripts/send-emails.mjs) to send
# anything. resend.com → API Keys. You also need a verified sending domain
# in Resend (resend.com → Domains) before it can send to anyone but
# yourself — see MANUAL_STEPS.md.
RESEND_API_KEY=

# Optional. "Name <address@yourdomain.com>", using the domain you verified
# in Resend. Falls back to Resend's shared test address (which can only
# actually deliver to your own Resend account email) if left blank.
SIFT_FROM_ADDRESS=

# Required for the email-delivery cron: the live website's URL, used to
# build the "read online" and "manage your schedule" links inside each
# email. No trailing slash, e.g. https://sift.example.com
SITE_URL=
