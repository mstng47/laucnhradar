# Copy this file to .env and fill in the values.
# .env is gitignored — never commit real keys.

# Required: writes the briefing. console.anthropic.com → API Keys
ANTHROPIC_API_KEY=

# Optional locally, required for the daily automation to save results.
# Supabase → project → Settings → API
# Use the SECRET (service_role) key here, not the publishable one.
SUPABASE_URL=
SUPABASE_KEY=

# Not used yet — for emailing the briefing later.
RESEND_API_KEY=
