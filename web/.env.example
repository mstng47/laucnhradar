# Copy this file to .env.local and fill in real values (see README for where to find them).
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Server-only — never prefix this one with NEXT_PUBLIC_. Used only inside
# app/api/*/route.js (subscribe/unsubscribe) to read and write
# email_subscribers, which has no public RLS policy at all. Same value as
# the root project's SUPABASE_KEY (Supabase → project → Settings → API →
# the SECRET/service_role key, not the publishable one) — set it again
# here because the website is a separate deployment from the pipeline.
SUPABASE_SERVICE_ROLE_KEY=

# Same key as the root .env — used here only to send the "preferences
# saved" confirmation email right after someone signs up or edits their
# schedule. resend.com → API Keys.
RESEND_API_KEY=
